        {
          "id": "f547f920-d074-46c6-8c4f-656a3c75e9a5",
          "name": "Search articles",
          "request": {
            "name": "Search articles",
            "description": {
              "content": "Search for current and historical news articles by keyword with filtering by language, country, category, source, date range, and more.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) Keywords or phrase to search for. Supports logical operators (AND, OR, NOT) and exact phrase matching with quotes."
                },
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "<string>",
                  "description": "ISO 639-1 two-letter language code."
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "ISO 3166-1 alpha-2 two-letter country code."
                },
                {
                  "disabled": false,
                  "key": "max",
                  "value": "10",
                  "description": "Maximum number of articles to return (1-100)."
                },
                {
                  "disabled": false,
                  "key": "in",
                  "value": "<string>",
                  "description": "Comma-separated list of attributes to search in (title, description, content)."
                },
                {
                  "disabled": false,
                  "key": "nullable",
                  "value": "<string>",
                  "description": "Comma-separated list of attributes allowed to be null."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<dateTime>",
                  "description": "Lower bound publish date (YYYY-MM-DDThh:mm:ssZ)."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<dateTime>",
                  "description": "Upper bound publish date (YYYY-MM-DDThh:mm:ssZ)."
                },
                {
                  "disabled": false,
                  "key": "sortby",
                  "value": "publishedAt",
                  "description": "Sort order (publishedAt or relevance)."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for pagination (paid plans)."
                },
                {
                  "disabled": false,
                  "key": "expand",
                  "value": "<string>",
                  "description": "Set to \"content\" to retrieve the full article content (paid plans)."
                },
                {
                  "disabled": false,
                  "key": "apikey",
                  "value": "<string>",
                  "description": "(Required) API key for authentication."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
